generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Workspace {
  id               String                @id
  name             String
  authors          String
  venue            String
  userId           String                @default("unauthenticated")
  bibContent       String?
  revision         Int                   @default(0)
  bibKeys          Json?
  agentEvents      Json?
  chatMessages     Json?
  logoUrl          String?
  secondaryLogoUrl String?
  assets           Asset[]
  collabTickets    CollaborationTicket[]
  ingestFiles      IngestFile[]
  outputs          Output[]
  members          WorkspaceMember[]
  snapshots        WorkspaceSnapshot[]
}

/// Access is deliberately modelled separately from Clerk.  The userId field above
/// remains the backwards-compatible owner reference for existing workspaces.
model WorkspaceMember {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  role        String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model CollaborationTicket {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  tokenHash   String    @unique
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, userId, expiresAt])
}

model Output {
  id               String    @id
  workspaceId      String
  outputType       String
  templateId       String
  title            String
  isActive         Boolean   @default(false)
  themeColor       String?
  authors          String?
  sourceIds        Json?
  venue            String?
  logoUrl          String?
  secondaryLogoUrl String?
  cards            Card[]
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Card {
  id             String  @id
  outputId       String
  title          String
  column         Int?
  order          Int
  pattern        String
  content        String
  figureLayout   String
  heightBudget   Float?
  validation     String
  generatedLatex String?
  slideNotes     String?
  table          Json?
  figures        Json?
  sourceIds      Json?
  assignedAssets Asset[]
  output         Output  @relation(fields: [outputId], references: [id], onDelete: Cascade)
}

model Asset {
  id             String    @id
  workspaceId    String
  fileId         String
  filename       String?
  url            String?
  kind           String
  page           Int
  section        String?
  bbox           String?
  confidence     String
  heading        String?
  snippet        String?
  thumbnailUrl   String?
  caption        String?
  assignedCardId String?
  assignedSlot   String?
  tableRows      Json?
  assignedCard   Card?     @relation(fields: [assignedCardId], references: [id])
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, filename])
}

model IngestFile {
  id          String    @id
  workspaceId String
  name        String
  size        Int
  method      String
  status      String
  progress    Int
  error       String?
  dismissed   Boolean   @default(false)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model WorkspaceSnapshot {
  id          String    @id @default(cuid())
  workspaceId String
  savedAt     DateTime  @default(now())
  label       String?
  revision    Int
  snapshot    String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, savedAt(sort: Desc)])
}

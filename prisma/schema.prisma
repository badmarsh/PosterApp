generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "windows"]
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model DocumentChunk {
  id          String   @id @default(cuid())
  workspaceId String
  documentId  String
  heading     String?
  content     String
  tokens      Int
  embedding   Unsupported("vector(384)")?
  createdAt   DateTime @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model Workspace {
  id               String                @id
  name             String
  authors          String
  venue            String
  userId           String                @default("unauthenticated")
  bibContent       String?
  revision         Int                   @default(0)
  bibKeys          Json?
  agentEvents      Json?
  chatMessages     Json?
  logoUrl          String?
  secondaryLogoUrl String?
  assets           Asset[]
  collabTickets    CollaborationTicket[]
  ingestFiles      IngestFile[]
  outputs          Output[]
  members          WorkspaceMember[]
  snapshots        WorkspaceSnapshot[]
  thesisReviews    ThesisReview[]
  documentChunks   DocumentChunk[]
  graphNodes       GraphNode[]
  graphEdges       GraphEdge[]
}

/// Access is deliberately modelled separately from Clerk.  The userId field above
/// remains the backwards-compatible owner reference for existing workspaces.
model WorkspaceMember {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  role        String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model CollaborationTicket {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  tokenHash   String    @unique
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, userId, expiresAt])
}

model Output {
  id               String    @id
  workspaceId      String
  outputType       String
  templateId       String
  title            String
  isActive         Boolean   @default(false)
  themeColor       String?
  authors          String?
  sourceIds        Json?
  venue            String?
  logoUrl          String?
  secondaryLogoUrl String?
  cards            Card[]
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Card {
  id             String  @id
  outputId       String
  title          String
  column         Int?
  order          Int
  pattern        String
  content        String
  figureLayout   String
  heightBudget   Float?
  validation     String
  generatedLatex String?
  slideNotes     String?
  table          Json?
  figures        Json?
  sourceIds      Json?
  assignedAssets Asset[]
  output         Output  @relation(fields: [outputId], references: [id], onDelete: Cascade)
}

model Asset {
  id             String    @id
  workspaceId    String
  fileId         String
  filename       String?
  url            String?
  kind           String
  page           Int
  section        String?
  bbox           String?
  confidence     String
  heading        String?
  snippet        String?
  thumbnailUrl   String?
  caption        String?
  assignedCardId String?
  assignedSlot   String?
  tableRows      Json?
  assignedCard   Card?     @relation(fields: [assignedCardId], references: [id], onDelete: SetNull)
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, filename])
}

model IngestFile {
  id          String    @id
  workspaceId String
  name        String
  size        Int
  method      String
  status      String
  progress    Int
  error       String?
  dismissed   Boolean   @default(false)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model WorkspaceSnapshot {
  id          String    @id @default(cuid())
  workspaceId String
  savedAt     DateTime  @default(now())
  label       String?
  revision    Int
  snapshot    String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, savedAt(sort: Desc)])
}

/// Stores metadata for a thesis assessment (posudok diplomovej práce).
/// Each workspace can have multiple reviews (supervisor + opponent).
model ThesisReview {
  id              String    @id @default(cuid())
  schemaVersion   String    @default("1.0")
  workspaceId     String
  /// Full name of the student author
  studentName     String
  /// Title of the thesis as submitted
  thesisTitle     String
  /// "bachelor" | "master" | "phd"
  thesisType      String    @default("master")
  /// "supervisor" | "opponent"
  reviewerRole    String    @default("opponent")
  /// Name of the reviewing person
  reviewerName    String?
  institution     String?
  department      String?
  /// Overall ECTS grade: A | B | C | D | E | FX | pending
  grade           String?
  /// Suggested ECTS grade by AI or initial analysis
  suggestedGrade  String?
  /// Final confirmed ECTS grade by human reviewer
  finalGrade      String?
  /// Formal recommendation text (obhajoba doporučená / nedoporučená)
  recommendation  String?
  /// Suggested recommendation text by AI
  suggestedRecommendation String?
  /// Final confirmed recommendation text by human reviewer
  finalRecommendation String?
  /// Timestamp of human reviewer decision confirmation
  confirmedAt     DateTime?
  /// Serialized JSON: array of ThesisReviewSection objects
  sections        String?
  /// Generated defense questions (JSON string[])
  defenseQuestions String?
  /// Citation issues found (JSON string[])
  citationIssues  String?
  /// "thesis" | "paper" | "grant"
  reviewKind      String    @default("thesis")
  /// Target venue, journal, conference, or university
  targetVenue     String?
  /// Executive overview / summary of the manuscript
  summary         String?
  /// Strengths of the paper (JSON string[])
  strengths       String?
  /// Structured review findings with evidence anchors (JSON ReviewFinding[])
  findings        String?
  /// Source document revision hash at time of analysis
  sourceRevision  String?
  /// Rubric version used for evaluation
  rubricVersion   String?   @default("sk-academic-v1")
  /// Classified or user-specified academic discipline
  discipline      String?
  /// Proposed ECTS grade range (e.g. "A - B")
  proposedGradeRange String?
  /// Confidence level of the review (0.0 - 1.0)
  confidence      Float?
  /// Overview of source quality and review limitations
  limitationsSummary String?
  /// Serialized ReviewAnalysisPlan JSON
  analysisPlan    String?
  /// "consort" | "prisma" | "strobe" | "ml_reproducibility" | "none"
  reportingStandard String?
  /// Reporting guideline compliance checks (JSON ReportingGuidelineCheck[])
  reportingGuidelineChecks String?
  /// Confidential remarks for the editor / committee
  confidentialComments String?
  /// PhD Opponent enrichment data (track record, SOTA, statutory clauses) (JSON object)
  phdEnrichment   String?
  /// "draft" | "final"
  status          String    @default("draft")
  /// ISO language code: "sk" | "cs" | "en"
  language        String    @default("sk")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt(sort: Desc)])
}

model GraphNode {
  id          String   @id @default(cuid())
  workspaceId String
  documentId  String
  label       String   // "Methodology", "Dataset", "Metric", "Hypothesis", "Finding", "Citation"
  name        String
  description String?
  createdAt   DateTime @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sourceEdges GraphEdge[] @relation("SourceNode")
  targetEdges GraphEdge[] @relation("TargetNode")

  @@unique([workspaceId, label, name])
  @@index([workspaceId])
}

model GraphEdge {
  id          String   @id @default(cuid())
  workspaceId String
  sourceId    String
  targetId    String
  relation    String   // "EVALUATED_ON", "PROVES", "USES", "CITES"
  evidence    String?  // text snippet that proves this relationship
  createdAt   DateTime @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  source      GraphNode @relation("SourceNode", fields: [sourceId], references: [id], onDelete: Cascade)
  target      GraphNode @relation("TargetNode", fields: [targetId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([sourceId])
  @@index([targetId])
}


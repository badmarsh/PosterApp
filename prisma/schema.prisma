// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Workspace {
  id           String  @id
  name         String
  authors      String
  venue        String
  userId       String  @default("unauthenticated")
  bibContent   String?
  bibKeys      String? // JSON string
  agentEvents  String? // JSON string
  chatMessages String? // JSON string
  revision     Int     @default(0) // optimistic-lock revision for snapshot saves
  outputs      Output[]
  assets       Asset[]
  ingestFiles  IngestFile[]
  snapshots    WorkspaceSnapshot[]
}

model Output {
  id           String    @id
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  outputType   String    // "poster" | "slides" | "paper"
  templateId   String    // e.g. "atlas", "beamer-metropolis", "article-twocol"
  title        String    // output-specific title (e.g. "My Poster Title")
  isActive     Boolean   @default(false)
  cards        Card[]
}

model Card {
  id             String  @id
  outputId       String
  output         Output  @relation(fields: [outputId], references: [id], onDelete: Cascade)
  title          String
  column         Int?    // nullable — only used for poster output type
  order          Int
  pattern        String
  content        String
  table          String? // JSON string
  figures        String? // JSON string
  figureLayout   String
  sourceIds      String? // JSON string
  heightBudget   Float?
  validation     String
  generatedLatex String?
  slideNotes     String? // speaker notes for slides output type
  assignedAssets Asset[]
}

model Asset {
  id             String @id
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  fileId         String
  filename       String?
  url            String?
  kind           String
  page           Int
  section        String?
  bbox           String?
  confidence     String
  heading        String?
  snippet        String?
  thumbnailUrl   String?
  caption        String?
  tableRows      String? // JSON string
  assignedCardId String?
  assignedCard   Card? @relation(fields: [assignedCardId], references: [id], onDelete: SetNull)
  assignedSlot   String?
}

model IngestFile {
  id          String @id
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  size        Int
  method      String
  status      String
  progress    Int
  error       String?
  dismissed   Boolean @default(false)
}

model WorkspaceSnapshot {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  savedAt     DateTime  @default(now())
  label       String?   // optional user label, e.g. "Before AI rewrite"
  revision    Int       // workspace revision at time of snapshot
  snapshot    String    // full JSON of workspace GET response

  @@index([workspaceId, savedAt(sort: Desc)])
}

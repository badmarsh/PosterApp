generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  binaryTargets   = ["native", "windows", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [vector]
}

model DocumentChunk {
  id          String                 @id @default(cuid())
  workspaceId String
  documentId  String
  heading     String?
  content     String
  /// Token count. This IS the `tokenCount` of the evidence-first data model; the
  /// historical column name is kept so existing rows and queries stay valid.
  tokens      Int
  embedding   Unsupported("vector(384)")?
  /// Structural chunk kind: "prose" | "table" | "equation" | "figure_caption".
  /// Tables / equations / captions are never split across chunks.
  kind        String                 @default("prose")
  /// Anthropic-style contextual prefix (document title, research domain,
  /// hierarchical section path, section objective). Indexed for embedding +
  /// full-text search, but NEVER merged into `content`, which stays verbatim
  /// for evidence quote validation. NULL for chunks indexed before this column.
  contextPrefix String?

  // -------------------------------------------------------------------------
  // Evidence-first hierarchy (chunker v2). Every column is nullable or has a
  // default, so rows written by the v1 chunker remain readable and no existing
  // document has to be re-parsed for the migration to succeed.
  // -------------------------------------------------------------------------

  /// Fine-grained element type: "paragraph" | "table" | "equation" |
  /// "figure_caption" | "citation" | "section". `kind` is the coarse legacy view.
  chunkType   String                 @default("paragraph")
  /// Position in the emitted chunk sequence (document order).
  ordinal     Int                    @default(0)
  /// 1-based page range. NULL when the parser supplied no page anchors —
  /// page numbers are never synthesised.
  pageStart   Int?
  pageEnd     Int?
  chapter     String?
  section     String?
  subsection  String?
  /// Full heading breadcrumb, e.g. "Kapitola 3 > 3.1 Návrh > 3.1.1 Tréning".
  sectionPath String?
  /// Deterministic ids of the structural document elements this chunk covers.
  sourceElementIds String[]          @default([])
  /// Section-level reading unit this retrieval unit belongs to.
  parentChunkId  String?
  previousChunkId String?
  nextChunkId    String?
  characterCount Int?
  /// True when an atomic element (table/equation) exceeded the token budget and
  /// was emitted whole rather than split.
  oversized      Boolean             @default(false)
  /// SHA-256 of `content`; makes reindex idempotency checkable.
  contentHash    String?
  /// Provenance versions — a change in any of them means the index is stale.
  parserVersion        String?
  chunkerVersion       String?
  embeddingModelVersion String?
  schemaVersion        String?       @default("1.0")

  createdAt   DateTime               @default(now())
  workspace   Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  evidence    Evidence[]
  claims      ThesisClaim[]

  @@index([workspaceId])
  @@index([workspaceId, documentId])
  @@index([workspaceId, documentId, ordinal])
  @@index([embedding], map: "document_chunk_embedding_hnsw")
  @@index([workspaceId, kind])
  @@index([workspaceId, chunkType])
  @@index([workspaceId, parentChunkId])
  @@index([workspaceId, pageStart])
}

/// A verbatim, page-anchored span of a source document that a finding may cite.
///
/// Findings must reference Evidence rows, not free text: that is what makes
/// "every factual claim carries a source reference" enforceable rather than
/// aspirational. `quote` is copied verbatim from `DocumentChunk.content`.
model Evidence {
  id          String        @id @default(cuid())
  workspaceId String
  documentId  String
  chunkId     String
  /// 1-based page, copied from the chunk. NULL when the parser had no page info.
  page        Int?
  sectionPath String?
  /// "paragraph" | "table" | "equation" | "figure_caption" | "citation" | "section" | "graph" | "scholarly"
  elementType String        @default("paragraph")
  /// Id of the underlying object (chunk id, element id, graph edge id, paper id).
  elementId   String?
  quote       String
  /// Character offsets of `quote` inside the chunk content.
  startOffset Int?
  endOffset   Int?
  /// Who/what produced this evidence row.
  origin      String        @default("retrieval")
  createdAt   DateTime      @default(now())
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  chunk       DocumentChunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)
  claims      ThesisClaim[] @relation("ClaimEvidence")

  @@index([workspaceId, documentId])
  @@index([chunkId])
  @@index([workspaceId, elementType])
}

/// Claim type as classified by the extraction pipeline.
/// Stored as text (not an enum) so new types never require a migration.
model ThesisClaim {
  id             String        @id @default(cuid())
  workspaceId    String
  documentId     String
  chunkId        String?
  /// Deterministic: `claim-<sha256(normalizedText)[:16]>`. Re-extraction is idempotent.
  claimKey       String
  text           String
  normalizedText String
  /// "contribution" | "methodological" | "empirical" | "theoretical" |
  /// "performance" | "novelty" | "causal" | "generalization"
  claimType      String        @default("empirical")
  /// 0.0 – 1.0
  importance     Float         @default(0.5)
  chapter        String?
  section        String?
  page           Int?
  /// 0.0 – 1.0 confidence of the extraction itself (not of the claim's truth).
  confidence     Float         @default(0.5)
  /// Verification verdict: SUPPORTED | PARTIALLY_SUPPORTED | UNSUPPORTED |
  /// CONTRADICTED | UNCERTAIN. NULL until verified.
  verificationStatus String?
  /// Structured verification record (supporting/contradicting evidence ids,
  /// reasoning, whether the conclusion outruns the evidence).
  verification   Json?
  /// ScholarlyPaper ids whose content was compared against this claim.
  citedPaperIds  String[]      @default([])
  extractorVersion String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  chunk          DocumentChunk? @relation(fields: [chunkId], references: [id], onDelete: SetNull)
  evidence       Evidence[]    @relation("ClaimEvidence")

  @@unique([workspaceId, claimKey])
  @@index([workspaceId, documentId])
  @@index([workspaceId, claimType])
  @@index([workspaceId, verificationStatus])
}

/// Canonical scholarly document, merged across providers.
///
/// A citation is NOT a string: it is a record with DOI, authors, venue, dates
/// and provider provenance, connectable to the exact place it occurs in the
/// thesis (CitationOccurrence) and to the prior-art analysis of a claim.
model ScholarlyPaper {
  id             String    @id @default(cuid())
  workspaceId    String
  /// Normalised DOI (lowercase, `10.` prefix kept). Null when no DOI is known.
  doi            String?
  /// Normalised title key used for deduplication across providers.
  titleKey       String
  title          String
  authors        String[]  @default([])
  year           Int?
  /// ISO date when the provider exposed one; used by the temporal novelty logic.
  publicationDate DateTime?
  venue          String?
  abstract       String?
  citationCount  Int?
  /// "semantic-scholar" | "openalex" | "crossref" | "arxiv" | "bibliography" | "merged"
  sourceProvider String    @default("merged")
  /// Per-provider raw records that were merged into this one.
  provenance     Json?
  externalId     String?
  retrievedAt    DateTime  @default(now())
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  occurrences    CitationOccurrence[]

  @@unique([workspaceId, titleKey])
  @@index([workspaceId, doi])
  @@index([workspaceId, year])
}

/// One in-text occurrence of a citation, anchored to the chunk where it appears.
model CitationOccurrence {
  id           String          @id @default(cuid())
  workspaceId  String
  documentId   String
  paperId      String
  chunkId      String?
  page         Int?
  /// Verbatim sentence the citation appears in — the "citation context".
  context      String?
  /// "supports" | "contradicts" | "extends" | "compares_with" | "background" | "unknown"
  relation     String          @default("unknown")
  startOffset  Int?
  endOffset    Int?
  createdAt    DateTime        @default(now())
  workspace    Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  paper        ScholarlyPaper  @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@index([workspaceId, documentId])
  @@index([paperId])
  @@index([workspaceId, chunkId])
}

/// Structured observability record for one retrieval/reasoning request.
///
/// Stores counts, scores, model versions and per-stage latencies — never the
/// retrieved text itself, so a trace cannot leak manuscript content.
model RetrievalTrace {
  id            String    @id @default(cuid())
  workspaceId   String
  reviewId      String?
  /// Criterion id or query category this trace belongs to.
  criterion     String?
  queryCategory String?
  query         String?
  /// Which retrieval route was taken ("dense+lexical", "drift", …).
  route         String?
  /// { source: candidateCount } per generator.
  candidateCounts Json?
  /// Fused / reranked scores of the selected evidence (ids + numbers only).
  ranking        Json?
  selectedEvidenceIds String[] @default([])
  graphNodeIds   String[]  @default([])
  communityIds   String[]  @default([])
  promptTokens   Int?
  modelVersions  Json?
  stageLatencyMs Json?
  totalLatencyMs Int?
  degraded       Json?
  createdAt      DateTime  @default(now())
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([workspaceId, criterion])
}

/// One evaluation / ablation / model-benchmark run.
model EvalRun {
  id          String    @id @default(cuid())
  workspaceId String?
  /// "retrieval" | "ablation" | "model-benchmark" | "novelty" | "evidence" | "review"
  kind        String
  name        String
  config      Json?
  metrics     Json?
  status      String    @default("completed")
  error       String?
  durationMs  Int?
  createdAt   DateTime  @default(now())

  @@index([kind, createdAt(sort: Desc)])
}

model Workspace {
  id               String                @id
  name             String
  authors          String
  venue            String
  /// Clerk user id of the owner. No default: a workspace must never be created
  /// without an owner (a previous default of "unauthenticated" hid such bugs).
  userId           String
  bibContent       String?
  revision         Int                   @default(0)
  bibKeys          Json?
  agentEvents      Json?
  chatMessages     Json?
  logoUrl          String?
  secondaryLogoUrl String?
  /// When false, DeerFlow deep-research runs are rejected for this workspace.
  deerflowEnabled  Boolean               @default(true)
  assets           Asset[]
  collabTickets    CollaborationTicket[]
  deerflowThreads  DeerflowThread[]
  documentChunks   DocumentChunk[]
  graphCommunities GraphCommunity[]
  graphEdges       GraphEdge[]
  graphNodes       GraphNode[]
  ingestFiles      IngestFile[]
  outputs          Output[]
  thesisReviews       ThesisReview[]
  members             WorkspaceMember[]
  snapshots           WorkspaceSnapshot[]
  agentApiKeys        AgentApiKey[]
  agentPendingChanges AgentPendingChange[]
  evidence            Evidence[]
  thesisClaims        ThesisClaim[]
  scholarlyPapers     ScholarlyPaper[]
  citationOccurrences CitationOccurrence[]
  retrievalTraces     RetrievalTrace[]

  @@index([userId])
}

/// Maps one PosterApp run to a DeerFlow sidecar thread. Durable source of
/// truth for run status + validated proposal; live progress lives in memory.
model DeerflowThread {
  id              String    @id @default(cuid())
  workspaceId     String
  userId          String
  deerThreadId    String    @unique
  kind            String
  /// "idle" | "queued" | "running" | "done" | "failed" | "cancelled"
  status          String    @default("idle")
  phase           String?
  /// Validated PosterResearchProposal JSON (never raw agent output).
  proposal        Json?
  error           String?
  costEstimateUsd Float?
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([userId])
}

/// Access is deliberately modelled separately from Clerk.  The userId field above
/// remains the backwards-compatible owner reference for existing workspaces.
model WorkspaceMember {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  /// "owner" | "editor" | "viewer" — enforced by a CHECK constraint in the DB
  /// (see migration 20260903120000_indexes_and_integrity).
  role        String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model CollaborationTicket {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  tokenHash   String    @unique
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, userId, expiresAt])
}

model Output {
  id               String    @id
  workspaceId      String
  outputType       String
  templateId       String
  title            String
  isActive         Boolean   @default(false)
  themeColor       String?
  authors          String?
  sourceIds        Json?
  venue            String?
  logoUrl          String?
  secondaryLogoUrl String?
  cards            Card[]
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model Card {
  id             String  @id
  outputId       String
  title          String
  column         Int?
  order          Int
  pattern        String
  content        String
  figureLayout   String
  heightBudget   Float?
  validation     String
  generatedLatex String?
  slideNotes     String?
  table          Json?
  figures        Json?
  sourceIds      Json?
  /// Quote anchors, suggested assets and layout truth from grounded auto-fill.
  grounding      Json?
  assignedAssets Asset[]
  output         Output  @relation(fields: [outputId], references: [id], onDelete: Cascade)

  @@index([outputId])
}

model Asset {
  id             String    @id
  workspaceId    String
  fileId         String
  filename       String?
  url            String?
  kind           String
  page           Int
  section        String?
  bbox           String?
  confidence     String
  heading        String?
  snippet        String?
  thumbnailUrl   String?
  caption        String?
  assignedCardId String?
  assignedSlot   String?
  tableRows      Json?
  assignedCard   Card?     @relation(fields: [assignedCardId], references: [id], onDelete: SetNull)
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, filename])
  @@index([workspaceId])
  @@index([assignedCardId])
}

model IngestFile {
  id              String    @id
  workspaceId     String
  name            String
  size            Int
  method          String
  status          String
  progress        Int
  error           String?
  dismissed       Boolean   @default(false)
  /// Number of DocumentChunks successfully created for this file
  vectorChunks    Int       @default(0)
  /// Timestamp when vectorStatus last transitioned to "ready"
  vectorIndexedAt DateTime?
  /// Vector indexing status: "pending" | "indexing" | "ready" | "error"
  /// "pending"  — not yet attempted (new uploads before ingestDocumentChunks fires)
  /// "indexing" — setImmediate callback is running (chunks being written)
  /// "ready"    — all chunks embedded and HNSW index created
  /// "error"    — embedding failed; see server logs
  vectorStatus    String    @default("pending")
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model WorkspaceSnapshot {
  id          String    @id @default(cuid())
  workspaceId String
  savedAt     DateTime  @default(now())
  label       String?
  source      String    @default("human")
  revision    Int
  snapshot    String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, savedAt(sort: Desc)])
  @@index([workspaceId, source])
}

/// Stores metadata for a thesis assessment (posudok diplomovej práce).
/// Each workspace can have multiple reviews (supervisor + opponent).
model ThesisReview {
  id                       String    @id @default(cuid())
  schemaVersion            String    @default("1.0")
  workspaceId              String
  /// Full name of the student author
  studentName              String
  /// Title of the thesis as submitted
  thesisTitle              String
  /// "bachelor" | "master" | "phd"
  thesisType               String    @default("master")
  /// "supervisor" | "opponent"
  reviewerRole             String    @default("opponent")
  /// Name of the reviewing person
  reviewerName             String?
  institution              String?
  department               String?
  /// Overall ECTS grade: A | B | C | D | E | FX | pending
  grade                    String?
  /// Suggested ECTS grade by AI or initial analysis
  suggestedGrade           String?
  /// Final confirmed ECTS grade by human reviewer
  finalGrade               String?
  /// Formal recommendation text (obhajoba doporučená / nedoporučená)
  recommendation           String?
  /// Suggested recommendation text by AI
  suggestedRecommendation  String?
  /// Final confirmed recommendation text by human reviewer
  finalRecommendation      String?
  /// Timestamp of human reviewer decision confirmation
  confirmedAt              DateTime?
  /// Serialized JSON: array of ThesisReviewSection objects
  sections                 String?
  /// Generated defense questions (JSON string[])
  defenseQuestions         String?
  /// Citation issues found (JSON string[])
  citationIssues           String?
  /// "thesis" | "paper" | "grant"
  reviewKind               String    @default("thesis")
  /// Target venue, journal, conference, or university
  targetVenue              String?
  /// Executive overview / summary of the manuscript
  summary                  String?
  /// Strengths of the paper (JSON string[])
  strengths                String?
  /// Structured review findings with evidence anchors (JSON ReviewFinding[])
  findings                 String?
  /// Source document revision hash at time of analysis
  sourceRevision           String?
  /// Rubric version used for evaluation
  rubricVersion            String?   @default("sk-academic-v1")
  /// Classified or user-specified academic discipline
  discipline               String?
  /// Proposed ECTS grade range (e.g. "A - B")
  proposedGradeRange       String?
  /// Confidence level of the review (0.0 - 1.0)
  confidence               Float?
  /// Overview of source quality and review limitations
  limitationsSummary       String?
  /// Serialized ReviewAnalysisPlan JSON
  analysisPlan             String?
  /// "consort" | "prisma" | "strobe" | "ml_reproducibility" | "none"
  reportingStandard        String?
  /// Reporting guideline compliance checks (JSON ReportingGuidelineCheck[])
  reportingGuidelineChecks String?
  /// Confidential remarks for the editor / committee
  confidentialComments     String?
  /// PhD Opponent enrichment data (track record, SOTA, statutory clauses) (JSON object)
  phdEnrichment            String?
  /// "draft" | "final"
  status                   String    @default("draft")
  /// ISO language code: "sk" | "cs" | "en"
  language                 String    @default("sk")
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  /// Multi-Agent debate transcript for Hivemind Bias mitigation
  debateLog                String?
  workspace                Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt(sort: Desc)])
}

model GraphNode {
  id          String      @id @default(cuid())
  workspaceId String
  documentId  String
  /// Entity type. v1 emitted 7 labels; v2 adds ResearchQuestion, Method, Variable,
  /// Experiment, Claim, Limitation, Conclusion, Paper, Figure, Table.
  label       String
  name        String
  description String?
  /// Canonical lookup key (diacritics folded, lowercased) used for dedup.
  canonicalKey String?
  /// Where the entity first appears — provenance for the node itself.
  page        Int?
  chunkId     String?
  extractorVersion String?
  createdAt   DateTime    @default(now())
  sourceEdges GraphEdge[] @relation("SourceNode")
  targetEdges GraphEdge[] @relation("TargetNode")
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, label, name])
  @@index([workspaceId])
  @@index([workspaceId, documentId])
  @@index([workspaceId, label])
}

model GraphEdge {
  id          String    @id @default(cuid())
  workspaceId String
  sourceId    String
  targetId    String
  /// Canonical relation: TESTS, SUPPORTS, CONTRADICTS, USES, EVALUATES, MEASURES,
  /// PRODUCES, DEPENDS_ON, CITES, EXTENDS, COMPARES_WITH, REFUTES, DERIVED_FROM, …
  relation    String
  evidence    String?
  documentId  String?
  /// Full provenance: which chunk, which page, how much to trust the extraction.
  /// Confidence-aware traversal refuses to build an argument on low-confidence
  /// edges unless nothing better exists.
  chunkId     String?
  page        Int?
  /// 0.0 – 1.0 extractor confidence. NULL = extracted before this column existed
  /// and must be treated as "unknown", NOT as "reliable".
  confidence  Float?
  extractorVersion String?
  createdAt   DateTime  @default(now())
  source      GraphNode @relation("SourceNode", fields: [sourceId], references: [id], onDelete: Cascade)
  target      GraphNode @relation("TargetNode", fields: [targetId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([sourceId])
  @@index([targetId])
  @@index([workspaceId, relation])
  @@index([workspaceId, chunkId])
}

/// Louvain-detected semantic community of graph nodes for cross-chapter synthesis.
model GraphCommunity {
  id            String    @id @default(cuid())
  workspaceId   String
  /// Human-readable label generated by LLM (e.g. "Methodology & Experiments")
  label         String
  /// JSON string[] of GraphNode IDs belonging to this community
  memberNodeIds Json
  /// LLM-generated narrative summary of what this community of concepts represents
  summary       String?
  nodeCount     Int       @default(0)
  /// Hierarchy level (0 = finest). Enables global → local drill-down.
  level         Int       @default(0)
  parentCommunityId String?
  /// Evidence ids backing the summary — a community report is not authoritative
  /// unless it can point at the text it summarises.
  evidenceIds   Json?
  /// Embedding of `summary`, so community retrieval can be query-aware instead
  /// of "top N by nodeCount". Nullable; width follows DocumentChunk.embedding.
  summaryEmbedding Unsupported("vector(384)")?
  extractorVersion String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  children      GraphCommunity[] @relation("CommunityHierarchy")
  parent        GraphCommunity?  @relation("CommunityHierarchy", fields: [parentCommunityId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([workspaceId, level])
  @@index([parentCommunityId])
}

model AgentApiKey {
  id              String               @id @default(cuid())
  tokenHash       String               @unique // sha256(raw); raw never stored
  name            String
  userId          String
  scopes          String[]
  workspaceId     String?              // null = all workspaces user can access (label loudly in UI)
  workspace       Workspace?           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  restrictCardIds String[]             @default([]) // non-empty = reads limited to these cards (§8.4)
  lastUsedAt      DateTime?
  createdAt       DateTime             @default(now())
  expiresAt       DateTime?
  revokedAt       DateTime?

  pendingChanges  AgentPendingChange[]
  toolCalls       AgentToolCallLog[]

  @@index([tokenHash])
  @@index([userId])
  @@index([workspaceId])
}

enum AgentChangeStatus {
  pending
  approved
  rejected
  expired
  applied
  failed
}

model AgentPendingChange {
  id          String            @id @default(cuid())
  workspaceId String
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  apiKeyId    String
  apiKey      AgentApiKey       @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  toolName    String            // canonical id, e.g. posterapp.cards.update
  targetType  String            // card | bibliography | asset | compile
  targetId    String?
  payload     Json              // validated tool args
  diffPreview Json?             // {before, after} for card/bib; null for compile
  rationale   String?           // agent-supplied, <= 2000 chars, wrapped as untrusted in UI
  status      AgentChangeStatus @default(pending)
  createdAt   DateTime          @default(now())
  expiresAt   DateTime          // createdAt + 7d default
  decidedAt   DateTime?
  decidedById String?
  snapshotId  String?           // set at apply time
  error       String?

  @@index([workspaceId, status])
  @@index([apiKeyId])
}

model AgentToolCallLog {
  id          String      @id @default(cuid())
  apiKeyId    String
  apiKey      AgentApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  workspaceId String?
  toolName    String
  args        Json
  result      Json?
  ok          Boolean     @default(true)
  approved    Boolean     @default(false)
  errorCode   String?
  durationMs  Int?
  changeId    String?     // link to AgentPendingChange if write
  calledAt    DateTime    @default(now())

  @@index([workspaceId, calledAt])
  @@index([apiKeyId, calledAt])
}

/// Global system configuration (e.g. registration toggle, maintenance mode).
/// Persisted in DB so runtime changes take effect immediately across all instances.
model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

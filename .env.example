# Required Environment Variables
# ==============================

# Clerk Auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
CLERK_SECRET_KEY=your_clerk_secret_key

# AI API Configuration (OpenRouter or OpenAI-compatible endpoint)
AI_API_URL=https://openrouter.ai/api/v1/chat/completions
AI_API_KEY=your_ai_api_key

# OpenRouter Image Editing / Legacy fallback
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Semantic Scholar API Key (for Academic Connector citation audit)
# Gets 100 requests/second with API key vs. 100 req/5min without
SEMANTIC_SCHOLAR_API_KEY=your_semantic_scholar_api_key

# ==============================================================================
# AI Models Configuration (Fallback defaults to AI_MODEL)
# ==============================================================================
AI_MODEL=gemini-3.1-pro-preview

# --- Vision & Multimodal ---
# AI_VISION_MODEL=qwen-omni-turbo
# AI_VISION_FALLBACK_MODELS=qwen-omni-turbo,qwen3-omni-flash,qwen3-vl-plus,qwen3-vl-flash,qwen-vl-max,qwen-vl-plus,qwen3-vl-235b-a22b-instruct,qwen3-omni-flash-2025-12-01,qwen3-vl-plus-2025-12-19,qwen3-vl-flash-2026-01-22
# AI_VISION_MAX_CHAIN=3                      # models tried per image (chain is capped; default 3)
# AI_VISION_CHAIN_DEADLINE_MS=90000          # wall-clock budget for the whole fallback chain per image
# AI_VISION_API_URL=https://your-vision-endpoint/v1/chat/completions
# AI_VISION_API_KEY=your_vision_api_key

# --- Core Authoring & Generation ---
# AI_GENERATION_MODEL=gemini-3.1-pro-preview   # Card auto-fill & section writing (high reasoning)
# AI_STRUCTURE_MODEL=gemini-3.1-pro-preview    # Multi-card poster decomposition & layout planning
# AI_CONVERT_MODEL=gemini-3.7-flash            # Cross-format adaptation (poster <-> slides <-> paper)
# AI_SHRINK_MODEL=gemini-3.7-flash             # Content condensing to fit LaTeX height budgets

# --- Review & Quality Assurance ---
# AI_REVIEW_MODEL=gemini-3.1-pro-preview       # Poster content review & factual grounding check
# AI_REVIEW_LAYOUT_MODEL=qwen3-vl-plus         # Multimodal visual overflow inspection
# AI_AUTOFIX_MODEL=qwen3-coder-plus            # LaTeX compiler error diagnosis & patch generation

# --- Utilities & Interaction ---
# AI_CHAT_MODEL=gemini-3.7-flash               # Interactive workspace assistant
# AI_BIBTEX_MODEL=gemini-3.7-flash             # Ingestion BibTeX citation extraction
# AI_LABELER_MODEL=gemini-3.7-flash            # Workspace version snapshot auto-labeling

# Distributed Rate Limiting (Optional - falls back to in-memory)
# UPSTASH_REDIS_REST_URL=https://your-upstash-redis-rest-url
# UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-rest-token


# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/posterapp"

# Application Secret
AUTH_SECRET="your-auth-secret-here"

# MinerU (WSL FastAPI sidecar)
MINERU_API_URL=http://localhost:8001
MINERU_BACKEND=vlm-transformers

# Workspace storage (relative to project root, created by app)
WORKSPACES_DIR=workspaces

# Clerk URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

NEXT_PUBLIC_YJS_WS_URL=ws://localhost:3333/api/yjs

# E2E test gates (empty by default; set in CI to enable LaTeX/Yjs e2e suites)
LATEX_AVAILABLE=
YJS_E2E=

# ==============================================================================
# Production hardening (see README "Production Deployment Checklist")
# ==============================================================================
# YPERSISTENCE=/var/lib/posterapp/yjs        # y-leveldb dir; keeps collaborative docs across restarts
# RATE_LIMIT_ALLOW_IN_MEMORY=1               # only for single-instance deployments without Upstash
# AI_REQUEST_TIMEOUT_MS=180000               # hard cap per AI provider round-trip
# AI_BREAKER_FAILURES=3                      # circuit breaker: consecutive 5xx/timeouts within window → open
# AI_BREAKER_WINDOW_MS=60000
# AI_BREAKER_OPEN_MS=30000                   # how long the primary is skipped (fallback used) before a trial call
# GRAPH_RAG_ENABLED=false                    # on by default; LLM entity extraction per ingested document (batched, capped)
# GRAPH_RAG_MAX_CHUNKS_PER_DOC=90
# GRAPH_RAG_DAILY_CAP=400                    # extraction calls per workspace per day
# AI_RERANKER_ENABLED=false                  # on by default: local cross-encoder reranker (Xenova/bge-reranker-base, ONNX)
# AI_HYDE_LLM=false                          # on by default: one LLM call per review generates criterion hypotheses for HyDE
# AI_CONTEXT_BUDGET_CHARS=120000             # total manuscript context per review prompt (routed+vector+graph)
# LATEX_COMPILER_IMAGE=texlive/texlive:latest
# E2E_AUTH_BYPASS=1                          # NEVER in production; dev/test Playwright only
